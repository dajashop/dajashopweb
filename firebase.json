{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "storage": [
    {
      "bucket": "daja-shop-site.firebasestorage.app",
      "rules": "storage.rules"
    }
  ],
  "extensions": {
    "firebase-web-authn": "./node_modules/@firebase-web-authn/extension"
  }
}
