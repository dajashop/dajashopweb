# .env file for Daja Shop Functions
# Ovaj fajl sadrži konfiguracione parametre za funkcije koje se koriste u Daja Shop aplikaciji.
# Ne delite ovaj fajl javno, jer sadrži osetljive informacije poput SMTP lozinki.

# Site URL (koristi se u emailovima i linkovima)
SITE_URL=https://dajashop.rs

# Newsletter prijave i dobrodoslice
SMTP_NEWSLETTER_USER=newsletter@dajashop.com
SMTP_NEWSLETTER_PASS=

# Porudzbine - potvrde i azuriranja kupcima
SMTP_ORDERS_USER=porudzbine@dajashop.com
SMTP_ORDERS_PASS=

# Admin notifikacije - interne poruke adminu
SMTP_ADMIN_USER=admin@dajashop.com
SMTP_ADMIN_PASS=

# Admin emailovi (comma-separated)
ADMIN_EMAILS="cvelenis42@yahoo.com,dajashopnis@gmail.com,lacio.biz@gmail.com"