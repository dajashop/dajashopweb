rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // --- JAVNI PRISTUP ZA PREUZIMANJE SLIKA (SVE DATOTEKE) ---
    match /{allPaths=**} {
      allow read: if true;  // Bilo ko može čitati
    }

    // --- ADMIN UPLOAD ZAŠTITA (samo admin korisnici po email-u) ---
    match /products/{productFolder}/{allFiles=**} {
      // SVE DATOTEKE U products/ FOLDERU
      // Samo autentifikovani korisnici čiji email je na admin listi
      allow write: if request.auth != null &&
                     (request.auth.token.email == "cvelenis42@yahoo.com" ||
                      request.auth.token.email == "dajashopnis@gmail.com" ||
                      request.auth.token.email == "lazar.cve@gmail.com");
    }

    // --- AVATARI KORISNIKA ---
    match /avatars/{userId}/{allFiles=**} {
      // Korisnik može pisati samo svoje avatar-e
      allow write: if request.auth != null && 
                     request.auth.uid == userId;
    }

    // --- 3D MODELI (SVE DATOTEKE) ---
    match /models/{allPaths=**} {
      // Autentifikovani korisnici (admini) mogu pisati
      allow write: if request.auth != null && 
                     request.auth.customClaims.admin == true;
    }
  }
}
