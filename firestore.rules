rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- JAVNE KOLEKCIJE (Čitanje bez autentifikacije) ---
    match /products/{document=**} {
      allow read: if true;  // Javno čitanje proizvoda
      allow create: if request.auth != null && 
                       request.auth.customClaims.admin == true;
      allow update: if request.auth != null && 
                       request.auth.customClaims.admin == true;
      allow delete: if request.auth != null && 
                       request.auth.customClaims.admin == true;
    }

    match /categories/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && 
                      request.auth.customClaims.admin == true;
    }

    match /brands/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && 
                      request.auth.customClaims.admin == true;
    }

    match /spec_keys/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && 
                      request.auth.customClaims.admin == true;
    }

    // --- KORISNIČKE KOLEKCIJE (Privatne) ---
    match /users/{userId} {
      allow read: if request.auth != null && 
                     (request.auth.uid == userId || 
                      request.auth.customClaims.admin == true);
      allow write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && 
                     (request.auth.uid == userId || 
                      request.auth.customClaims.admin == true);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // --- PORUDŽBINE (Samo čitanje za vlasnike) ---
    match /orders/{orderId} {
      allow read: if request.auth != null && 
                     (request.auth.uid == resource.data.userId || 
                      request.auth.customClaims.admin == true);
      allow write: if request.auth != null && 
                      request.auth.customClaims.admin == true;
      allow create: if request.auth != null;
    }

    // --- DEFAULT: Odbij sve ostalo ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
